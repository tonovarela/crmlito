APP_NAME="Candy CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_HOME_ABSOLUTE_URL=https://servicios.litoprocess.com/litoapps

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=host.docker.internal
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# true si SQL Server usa un certificado autofirmado (ODBC 18 cifra por defecto)
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

LABSMOBILE_USER=
LABSMOBILE_API_TOKEN=

WS_MC_URL=
